# Django
SECRET_KEY=django-insecure-change-me-please-00000000000000
DEBUG=True
DJANGO_SETTINGS_ENV=development
ALLOWED_HOSTS=127.0.0.1,localhost

# Database
# SQLite (dev)
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL (production example)
# DATABASE_URL=postgres://user:password@localhost:5432/intranet

# Time zone
TIME_ZONE=Asia/Manila
LANGUAGE_CODE=en-us

# Email (default: console backend in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@intranet.local

# Security (production)
# CORS_ALLOWED_ORIGINS=https://intranet.example.com
# CSRF_TRUSTED_ORIGINS=https://intranet.example.com

# Logging
LOG_LEVEL=INFO
